# Leave empty for local development: Vite proxies requests to http://127.0.0.1:7777.
# For a deployed frontend, set this to the deployed DevTinder backend URL.
VITE_API_URL=https://your-devtinder-api.example.com

# Optional: change only the local development proxy target.
# VITE_API_PROXY_TARGET=http://127.0.0.1:7777
